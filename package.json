{
  "name": "fleetline",
  "version": "1.0.0",
  "description": "Fleetline - a self-hosted MCP server + Agent Skill that lets a voice assistant (Alexa+) command a local agent fleet over Streamable HTTP",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:web",
    "build:web": "esbuild public-src/simulator.ts --bundle --format=esm --target=es2022 --outfile=public/simulator.js",
    "start": "node dist/src/index.js",
    "demo": "node dist/scripts/demo-client.js",
    "test": "tsc && node --test dist/test/*.test.js",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
